{
  "name": "copycart",
  "version": "0.2.0",
  "description": "Cross-exchange trader discovery and risk intelligence (demo-data build)",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p public/js/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "openapi": "node scripts/export-openapi.js",
    "keygen": "node scripts/generate-api-key.js",
    "smoke": "node scripts/smoke.cjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  }
}
