{
  "openapi": "3.0.3",
  "info": {
    "title": "CopyCart API",
    "version": "0.2.0",
    "description": "Demo-data build. No live exchange data."
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health and data mode",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/methodology": {
      "get": {
        "operationId": "getMethodology",
        "summary": "Scoring methodology, version and limitations",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/exchanges": {
      "get": {
        "operationId": "listExchanges",
        "summary": "Exchanges and adapter status (demo, planned or live)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/traders": {
      "get": {
        "operationId": "listTraders",
        "summary": "Search, filter, sort and paginate traders",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text search over name, strategy, markets, horizon",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "description": "Exchange id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "risk",
            "in": "query",
            "required": false,
            "description": "Risk label",
            "schema": {
              "type": "string",
              "enum": [
                "Low",
                "Moderate",
                "High",
                "Unknown"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort key",
            "schema": {
              "type": "string",
              "enum": [
                "score",
                "return",
                "drawdown",
                "name"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Sort order",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Page size (max 50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/traders/{id}": {
      "get": {
        "operationId": "getTrader",
        "summary": "Trader profile with score, provenance and freshness",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/traders/{id}/performance": {
      "get": {
        "operationId": "getTraderPerformance",
        "summary": "Observation series and cumulative curve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/traders/{id}/score": {
      "get": {
        "operationId": "getTraderScore",
        "summary": "Component scores, explanations and flags",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "operationId": "postEvent",
        "summary": "Record a privacy-minimal analytics event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/outbound/{exchangeId}": {
      "get": {
        "operationId": "outboundRedirect",
        "summary": "Validated outbound redirect that records a click (not a conversion)",
        "parameters": [
          {
            "name": "exchangeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "operationId": "analyticsSummary",
        "summary": "Aggregate analytics counts (API key required)",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  }
}
